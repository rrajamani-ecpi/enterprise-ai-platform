@inject ChatComposerState State
@inject ConversationListState ListState
@implements IDisposable

<div class="chat-home">
    <header class="chat-home-header">
        @if (State.CurrentUser is not null)
        {
            <span>Signed in as @State.CurrentUser.Name (@State.CurrentUser.Email)</span>
        }
    </header>

    <ChatTranscript Messages="State.Messages" />

    <ChatComposer @bind-ComposerText="State.ComposerText"
                  IsStreaming="State.IsStreaming"
                  ErrorMessage="@State.ErrorMessage"
                  OnSend="SendAsync" />
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChanged += StateHasChanged;
    }

    private async Task SendAsync()
    {
        await State.SendAsync();

        // Spec 024 US3 FR-005 — a send bumps the thread's activity time server-side (ChatPipeline),
        // so refresh the sidebar order to reflect it.
        await ListState.LoadConversationsAsync();
    }

    public void Dispose()
    {
        State.OnChanged -= StateHasChanged;
    }
}
